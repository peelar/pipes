{
  "name": "pipes-workspace",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "reset": "bun scripts/reset.ts",
    "dev": "bun --watch packages/pipes/src/dev.ts",
    "build": "bun scripts/build.ts",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "pipes": "bun packages/pipes/src/cli.ts",
    "pipesd": "bun packages/pipes/src/server.ts",
    "test": "bun test",
    "check": "vp check && tsc --noEmit && bun test",
    "typecheck": "tsc --noEmit",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "postinstall": "effect-tsgo patch"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.2",
    "@effect/tsgo": "0.43.0",
    "@nkzw/oxlint-config": "2.0.1",
    "@openai/codex": "0.153.4",
    "@opentui/core-darwin-x64": "0.5.11",
    "@opentui/core-linux-arm64": "0.5.11",
    "@opentui/core-linux-x64": "0.5.11",
    "@types/bun": "latest",
    "@types/react": "latest",
    "oxlint": "1.81.0",
    "typescript": "7.0.2",
    "vite-plus": "0.3.1"
  },
  "engines": {
    "bun": ">=1.4.2",
    "node": ">=22.18.0"
  },
  "packageManager": "bun@1.4.2"
}
